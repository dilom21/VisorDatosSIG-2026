# ============================================================
# VisorDatosSIG - Variables de entorno para Docker
# Copiar este archivo como .env y completar los valores reales.
# NUNCA subir .env al repositorio.
# ============================================================

# URL pública desde la que el navegador accederá al sistema.
# Local:
PUBLIC_BASE_URL=http://localhost

# Puerto HTTP publicado por Nginx.
HTTP_PORT=80

# ------------------------------------------------------------
# Azure SQL
# ------------------------------------------------------------
# Cadena real de conexión a la base VisorDatosSIG en Azure SQL.
ConnectionStrings__VisorDatosSIG=

# ------------------------------------------------------------
# JWT
# ------------------------------------------------------------
JWT_ISSUER=VisorDatosSIG.Api
JWT_AUDIENCE=VisorDatosSIG.Clientes
JWT_EXPIRATION_MINUTES=480

# Debe ser una clave fuerte y secreta.
Jwt__Key=