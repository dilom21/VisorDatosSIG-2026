FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copiar archivos de configuración de compilación
COPY Directory.Build.props Directory.Build.targets ./

# Copiar proyectos necesarios para restaurar
COPY src/VisorDatosSIG.Domain/VisorDatosSIG.Domain.csproj src/VisorDatosSIG.Domain/
COPY src/VisorDatosSIG.Application/VisorDatosSIG.Application.csproj src/VisorDatosSIG.Application/
COPY src/VisorDatosSIG.Web/VisorDatosSIG.Web.csproj src/VisorDatosSIG.Web/

RUN dotnet restore src/VisorDatosSIG.Web/VisorDatosSIG.Web.csproj

# Copiar código fuente
COPY src/VisorDatosSIG.Domain/ src/VisorDatosSIG.Domain/
COPY src/VisorDatosSIG.Application/ src/VisorDatosSIG.Application/
COPY src/VisorDatosSIG.Web/ src/VisorDatosSIG.Web/

WORKDIR /src/src/VisorDatosSIG.Web
RUN dotnet publish -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080

ENTRYPOINT ["dotnet", "VisorDatosSIG.Web.dll"]
