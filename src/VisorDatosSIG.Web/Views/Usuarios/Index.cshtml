@*
    CU03 - Gestionar Usuarios
    Interfaz moderna, accesible y de alta densidad para la administración de usuarios,
    roles y credenciales en VisorDatosSIG.

    Consumido por: js/usuarios/usuarios.js contra /api/usuarios
    Autorización dinámica: dbo.RolMenu (/Usuarios)
*@
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Gestión de Usuarios";
}

@section Styles {
    <link rel="stylesheet" href="~/css/usuarios.css" asp-append-version="true" />
}

<section class="usuarios-seccion">
    <!-- Encabezado de la página -->
    <header class="usuarios-cabecera">
        <div class="usuarios-cabecera__info">
            <span class="usuarios-cabecera__modulo">Usuarios y Seguridad</span>
            <h1 class="usuarios-cabecera__titulo">Gestión de Usuarios</h1>
            <p class="usuarios-cabecera__intro">
                Administre las cuentas del sistema, asigne roles de acceso operativo y controle el estado y credenciales de los usuarios.
            </p>
        </div>
        <div class="usuarios-cabecera__acciones">
            <button id="btn-abrir-crear" type="button" class="btn-nuevo-usuario">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="8.5" cy="7" r="4"></circle>
                    <line x1="20" y1="8" x2="20" y2="14"></line>
                    <line x1="23" y1="11" x2="17" y2="11"></line>
                </svg>
                <span>Nuevo usuario</span>
            </button>
        </div>
    </header>

    <!-- Aviso accesible de estado (éxito / error) -->
    <div id="gestion-mensaje" class="usuarios-notificacion" role="status" aria-live="polite" hidden>
        <span class="usuarios-notificacion__icono" id="notif-icono" aria-hidden="true"></span>
        <div class="usuarios-notificacion__texto" id="notif-texto"></div>
        <button type="button" class="usuarios-notificacion__cerrar" id="notif-cerrar" aria-label="Cerrar notificación">×</button>
    </div>

    <!-- Contenedor del módulo (protegido por guard.js) -->
    <div id="gestion-contenido" class="usuarios-contenido" hidden>

        <!-- Tarjetas de Métricas (KPIs) -->
        <div class="usuarios-metricas">
            <div class="metrica-card metrica-card--total">
                <div class="metrica-card__icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </div>
                <div class="metrica-card__datos">
                    <span id="kpi-total" class="metrica-card__valor">0</span>
                    <span class="metrica-card__etiqueta">Total Usuarios</span>
                </div>
            </div>

            <div class="metrica-card metrica-card--activos">
                <div class="metrica-card__icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <div class="metrica-card__datos">
                    <span id="kpi-activos" class="metrica-card__valor">0</span>
                    <span class="metrica-card__etiqueta">Usuarios Conectados</span>
                </div>
            </div>

            <div class="metrica-card metrica-card--inactivos">
                <div class="metrica-card__icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                    </svg>
                </div>
                <div class="metrica-card__datos">
                    <span id="kpi-inactivos" class="metrica-card__valor">0</span>
                    <span class="metrica-card__etiqueta">Desconectados</span>
                </div>
            </div>

            <div class="metrica-card metrica-card--admin">
                <div class="metrica-card__icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                </div>
                <div class="metrica-card__datos">
                    <span id="kpi-admin" class="metrica-card__valor">0</span>
                    <span class="metrica-card__etiqueta">Administradores</span>
                </div>
            </div>
        </div>

        <!-- Barra de herramientas: Búsqueda y Filtros -->
        <div class="usuarios-toolbar">
            <div class="usuarios-buscar">
                <span class="usuarios-buscar__icono" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </span>
                <input id="usuarios-buscar" type="search" placeholder="Buscar por usuario, nombre o rol..."
                       class="usuarios-buscar__input" autocomplete="off" />
            </div>

            <div class="usuarios-filtro-grupo">
                <label for="usuarios-filtro-rol">Rol:</label>
                <select id="usuarios-filtro-rol" class="usuarios-select">
                    <option value="">Todos los roles</option>
                </select>
            </div>

            <div class="usuarios-filtro-grupo">
                <label for="usuarios-filtro-estado">Conexión:</label>
                <select id="usuarios-filtro-estado" class="usuarios-select">
                    <option value="">Todos</option>
                    <option value="true">Conectados</option>
                    <option value="false">Desconectados</option>
                </select>
            </div>

            <button id="usuarios-recargar" type="button" class="btn-secundario-toolbar" title="Actualizar listado">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67" />
                </svg>
                <span>Actualizar</span>
            </button>
        </div>

        <!-- Tabla moderna de usuarios -->
        <div class="usuarios-tabla-card">
            <div class="usuarios-tabla-card__header">
                <h2 class="usuarios-tabla-card__titulo">Cuentas Registradas</h2>
                <span id="usuarios-conteo" class="usuarios-tabla-card__conteo">Mostrando 0 usuarios</span>
            </div>
            <div class="usuarios-tabla-contenedor">
                <table class="usuarios-tabla">
                    <thead>
                        <tr>
                            <th scope="col">Usuario</th>
                            <th scope="col">Nombre Completo</th>
                            <th scope="col">Roles Asignados</th>
                            <th scope="col">Estado</th>
                            <th scope="col" style="text-align: center;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="usuarios-lista">
                        <!-- Filas insertadas dinámicamente -->
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>

<!-- Diálogo Modal: Crear / Editar Usuario -->
<div id="modal-usuario" class="modal" hidden data-modal>
    <div class="modal__fondo" id="modal-usuario-fondo"></div>
    <div class="modal__dialogo modal-usuario-dialogo" role="dialog" aria-modal="true" aria-labelledby="usuario-titulo">
        <header class="modal__encabezado">
            <div>
                <h2 id="usuario-titulo" class="modal__titulo">Crear Usuario</h2>
                <p id="usuario-subtitulo" class="modal__subtitulo">Complete los datos de la cuenta y asigne los roles de acceso.</p>
            </div>
            <button type="button" id="btn-cerrar-modal" class="modal__cerrar" aria-label="Cerrar ventana">×</button>
        </header>

        <form id="usuario-form" novalidate>
            <div class="modal__cuerpo">
                <p id="modal-usuario-error" class="modal__error" role="alert" hidden></p>

                <div class="form-grupo">
                    <label for="usuario-login">Nombre de usuario (Login) <span class="requerido">*</span></label>
                    <input id="usuario-login" type="text" maxlength="100" placeholder="Ej. rgutierrez" class="form-control" autocomplete="off" required />
                    <span class="form-ayuda">Identificador único con el que iniciará sesión</span>
                </div>

                <div class="form-grupo">
                    <label for="usuario-nombre">Nombre completo <span class="requerido">*</span></label>
                    <input id="usuario-nombre" type="text" maxlength="240" placeholder="Ej. Roberto Gutierrez Paz" class="form-control" required />
                </div>

                <div id="password-inicial-grupo" class="form-grupo">
                    <label for="usuario-password">Contraseña inicial <span class="requerido">*</span></label>
                    <div class="input-password-wrapper">
                        <input id="usuario-password" type="password" minlength="8" maxlength="200" placeholder="Mínimo 8 caracteres" class="form-control" autocomplete="new-password" required />
                        <button type="button" class="btn-toggle-pass" data-target="usuario-password" aria-label="Mostrar contraseña">
                            <svg class="icono-ojo" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                    <span class="form-ayuda">Debe contener mayúsculas, minúsculas y números o símbolos</span>
                </div>

                <div class="form-grupo">
                    <label class="label-roles">Roles de acceso al sistema <span class="requerido">*</span></label>
                    <div id="usuario-roles" class="roles-grid">
                        <!-- Casillas dinámicas con estilo de tarjeta -->
                    </div>
                </div>
            </div>

            <footer class="modal__pie">
                <button type="button" id="usuario-cancelar" class="btn-cancelar">Cancelar</button>
                <button type="submit" id="btn-guardar-usuario" class="btn-guardar">Guardar usuario</button>
            </footer>
        </form>
    </div>
</div>

<!-- Diálogo Modal: Restablecer Contraseña -->
<div id="modal-reset" class="modal" hidden data-modal>
    <div class="modal__fondo" id="modal-reset-fondo"></div>
    <div class="modal__dialogo modal-reset-dialogo" role="dialog" aria-modal="true" aria-labelledby="reset-titulo">
        <header class="modal__encabezado">
            <div>
                <h2 id="reset-titulo" class="modal__titulo">Restablecer Contraseña</h2>
                <p id="reset-subtitulo" class="modal__subtitulo">Asigne una nueva credencial de acceso para el usuario.</p>
            </div>
            <button type="button" id="btn-cerrar-reset" class="modal__cerrar" aria-label="Cerrar ventana">×</button>
        </header>

        <form id="reset-form" novalidate>
            <div class="modal__cuerpo">
                <p id="modal-reset-error" class="modal__error" role="alert" hidden></p>

                <div class="form-grupo">
                    <label for="reset-password">Nueva contraseña <span class="requerido">*</span></label>
                    <div class="input-password-wrapper">
                        <input id="reset-password" type="password" minlength="8" maxlength="200" placeholder="Mínimo 8 caracteres" class="form-control" autocomplete="new-password" required />
                        <button type="button" class="btn-toggle-pass" data-target="reset-password" aria-label="Mostrar contraseña">
                            <svg class="icono-ojo" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="form-grupo">
                    <label for="reset-confirmar">Confirmar nueva contraseña <span class="requerido">*</span></label>
                    <div class="input-password-wrapper">
                        <input id="reset-confirmar" type="password" minlength="8" maxlength="200" placeholder="Repita la nueva contraseña" class="form-control" autocomplete="new-password" required />
                        <button type="button" class="btn-toggle-pass" data-target="reset-confirmar" aria-label="Mostrar contraseña">
                            <svg class="icono-ojo" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

            <footer class="modal__pie">
                <button type="button" id="reset-cancelar" class="btn-cancelar">Cancelar</button>
                <button type="submit" id="btn-confirmar-reset" class="btn-guardar">Restablecer contraseña</button>
            </footer>
        </form>
    </div>
</div>

<!-- Diálogo Modal: Confirmar Cambio de Estado -->
<div id="modal-estado" class="modal" hidden data-modal>
    <div class="modal__fondo" id="modal-estado-fondo"></div>
    <div class="modal__dialogo modal-estado-dialogo" role="dialog" aria-modal="true" aria-labelledby="estado-titulo">
        <header class="modal__encabezado">
            <div>
                <h2 id="estado-titulo" class="modal__titulo">Cambiar Estado</h2>
                <p id="estado-subtitulo" class="modal__subtitulo">Confirmación de activación o desactivación de cuenta.</p>
            </div>
            <button type="button" id="btn-cerrar-estado" class="modal__cerrar" aria-label="Cerrar ventana">×</button>
        </header>

        <div class="modal__cuerpo">
            <p id="estado-mensaje-pregunta" class="estado-mensaje-pregunta"></p>
        </div>

        <footer class="modal__pie">
            <button type="button" id="btn-cancelar-estado" class="btn-cancelar">Cancelar</button>
            <button type="button" id="btn-confirmar-estado" class="btn-guardar">Confirmar</button>
        </footer>
    </div>
</div>

@section Scripts {
    <script src="~/js/usuarios/usuarios.js" asp-append-version="true"></script>
    <script>
        window.VisorSIG.guard.protegerPagina({
            returnUrl: '/Usuarios',
            alValidar: function () { window.VisorSIG.usuarios.iniciar(); }
        });
    </script>
}
