@{
    // El visor pasa al workspace autenticado: obtiene el sidebar dinámico, el modo
    // oscuro y el pie de sesión del layout _AppLayout. El mapa, las capas y el guard
    // de sesión no cambian.
    Layout = "_AppLayout";
    ViewData["Title"] = "Visor cartográfico";
}
@section Styles {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
}
<section class="visor-shell">
    <aside class="visor-panel">
        <div class="visor-panel__head">
            <h2>Capas</h2>
            <p>Cuatro capas disponibles con datos reales desde la base de datos.</p>
        </div>

        @* Aviso heredado del visor. El guard de sesión escribe ahora en el aviso del
           layout (#app-aviso, marcado con data-visor-aviso) porque es único para todas
           las páginas del workspace; este elemento se conserva por compatibilidad con
           el contrato documentado del visor y permanece oculto. *@
        <p id="visor-aviso" class="visor-aviso" role="status" hidden></p>

        <ul class="visor-panel__lista">
            <li class="visor-panel__item">
                <label class="visor-capa" for="capa-manzanas">
                    <input type="checkbox" id="capa-manzanas" checked />
                    <span class="visor-capa__nombre">Manzanas</span>
                </label>
                <span id="estado-manzanas" class="visor-badge visor-badge--cargando">Cargando...</span>
            </li>
            <li class="visor-panel__item">
                <label class="visor-capa" for="capa-lotes">
                    <input type="checkbox" id="capa-lotes" />
                    <span class="visor-capa__nombre">Lotes</span>
                </label>
                <span id="estado-lotes" class="visor-badge visor-badge--inactiva">Inactiva</span>
            </li>
            <li class="visor-panel__item">
                <label class="visor-capa" for="capa-codigos-fijos">
                    <input type="checkbox" id="capa-codigos-fijos" checked />
                    <span class="visor-capa__nombre">Códigos Fijos</span>
                </label>
                <span id="estado-codigos-fijos" class="visor-badge visor-badge--cargando">Cargando...</span>
            </li>
            <li class="visor-panel__item">
                <label class="visor-capa" for="capa-vias">
                    <input type="checkbox" id="capa-vias" checked />
                    <span class="visor-capa__nombre">Vías</span>
                </label>
                <span id="estado-vias" class="visor-badge visor-badge--cargando">Cargando...</span>
            </li>
        </ul>

        @* Los conteos reciben su texto por textContent: sin nodos hijos y sin
           rol de región viva (el resumen consolidado es el único live region). *@
        <ul class="visor-panel__conteos">
            <li id="conteo-manzanas" class="visor-panel__conteo"></li>
            <li id="conteo-lotes" class="visor-panel__conteo"></li>
            <li id="conteo-codigos-fijos" class="visor-panel__conteo"></li>
            <li id="conteo-vias" class="visor-panel__conteo"></li>
        </ul>

        <div id="leyenda-capas" class="visor-leyenda" hidden></div>
        <p id="resumen-capas" class="visor-resumen" role="status" aria-live="polite"></p>

        @* FE-SIG 5: búsqueda alfanumérica real (Manzanas, Lotes, Códigos Fijos y
           Vías) contra el endpoint protegido api/catastro/buscar. El estado, los
           resultados y la paginación reciben su contenido por textContent desde
           search.js; por eso no llevan nodos hijos en el marcado. *@
        <div id="panel-busqueda" class="visor-busqueda">
            <h3 class="visor-busqueda__titulo">Buscar</h3>
            <form id="form-busqueda" class="visor-busqueda__form" role="search" novalidate>
                <label class="visor-busqueda__label" for="texto-busqueda">Buscar</label>
                <input type="search" id="texto-busqueda" name="q" class="visor-busqueda__input"
                       placeholder="Buscar UV, manzana, lote, código, nombre o vía"
                       autocomplete="off" />
                <label class="visor-busqueda__label" for="filtro-capa">Capa</label>
                <select id="filtro-capa" name="capa" class="visor-busqueda__select">
                    <option value="">Todas las capas</option>
                    <option value="Manzanas">Manzanas</option>
                    <option value="Lotes">Lotes</option>
                    <option value="CodigosFijos">Códigos Fijos</option>
                    <option value="Vias">Vías</option>
                </select>
                <div class="visor-busqueda__acciones">
                    <button type="submit" id="btn-buscar" class="btn-primario visor-busqueda__boton">Buscar</button>
                    <button type="button" id="btn-limpiar-busqueda" class="btn-secundario visor-busqueda__boton">Limpiar</button>
                </div>
            </form>
            <p id="estado-busqueda" class="visor-busqueda__estado" role="status" aria-live="polite"></p>
            <div id="resultados-busqueda" class="visor-busqueda__resultados"></div>
            <div id="paginacion-busqueda" class="visor-busqueda__paginacion" hidden></div>
        </div>

        @* FE-SIG 4: modo Identificar. El botón alterna aria-pressed y el panel
           solo se muestra con el modo activo. Las zonas de coordenadas, estado y
           resultados reciben su contenido por textContent desde identify.js; por
           eso no llevan nodos hijos en el marcado. *@
        <div class="visor-identificar">
            <button type="button" id="btn-identificar" class="btn-secundario visor-identificar__boton" aria-pressed="false">
                Identificar
            </button>
            <div id="panel-identificacion" class="visor-identificacion" hidden>
                <p id="coordenadas-identificacion" class="visor-identificacion__coords"></p>
                <p id="estado-identificacion" class="visor-identificacion__estado" role="status" aria-live="polite"></p>
                <div id="resultados-identificacion" class="visor-identificacion__resultados"></div>
                <p class="visor-identificacion__nota">
                    Los resultados corresponden al último clic, con el estado de
                    capas activo en ese momento. La próxima identificación aplicará
                    los cambios de capas.
                </p>
            </div>
        </div>

        <p class="visor-panel__nota">
            Las cuatro capas consumen información geográfica real desde la base de datos a través de la API.
        </p>
    </aside>
    <div id="map" class="visor-map" aria-label="Mapa del VisorDatosSIG"></div>
</section>
@section Scripts {
    <script src="~/lib/leaflet/leaflet.js"></script>
    <script src="~/js/visor/map.js"></script>
    <script src="~/js/visor/geojson.js"></script>
    <script src="~/js/visor/features.js"></script>
    <script src="~/js/visor/markers.js"></script>
    <script src="~/js/visor/layers.js"></script>
    <script src="~/js/visor/legend.js"></script>
    <script src="~/js/visor/identify.js"></script>
    <script src="~/js/visor/search.js"></script>
    <script>
        window.VisorSIG.guard.protegerPagina({ returnUrl: '/Visor' });
    </script>
}
