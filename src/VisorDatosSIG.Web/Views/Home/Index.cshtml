@{
    ViewData["Title"] = "Inicio - Plataforma Geoespacial Inteligente";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}

<div class="home-v4" id="inicio">
    <section class="hero" aria-labelledby="hero-title">
        <div class="hero-wrap">
            <div class="hero-copy">
                <div class="eyebrow">Inicio público para invitados y clientes</div>
                <h1 id="hero-title">Plataforma <span class="accent">Geoespacial</span><br />Inteligente</h1>
                <p class="hero-lead">
                    Explora, consulta y comprende la información geográfica de Santa Cruz desde una plataforma
                    clara, visual y preparada para transformar datos territoriales en mejores decisiones.
                </p>

                <div class="hero-badges" aria-label="Características principales">
                    <span>Web y móvil</span>
                    <span>Cartografía inteligente</span>
                    <span>Capas vectoriales integradas</span>
                    <span>Visualización territorial</span>
                </div>

                <div class="hero-actions">
                    <div data-sesion-anonimo>
                        <a class="btn btn-primary" asp-controller="Cuenta" asp-action="Login">
                            <span>Acceder a la plataforma</span>
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M5 12h14M13 6l6 6-6 6" />
                            </svg>
                        </a>
                    </div>

                    <div data-sesion-bloque hidden>
                        <p class="hero-saludo">Sesión iniciada como: <strong data-sesion-nombre></strong></p>
                        <a class="btn btn-primary" asp-controller="Visor" asp-action="Index">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3V6Z" />
                                <path d="M9 3v15M15 6v15" />
                            </svg>
                            <span>Abrir visor cartográfico</span>
                        </a>
                    </div>

                    <a class="btn btn-secondary" href="#capas">Explorar capacidades</a>
                    <a class="btn btn-secondary" href="#arquitectura">Ver arquitectura</a>
                </div>

                <div class="hero-metrics">
                    <article class="metric">
                        <strong>4</strong>
                        <span>capas vectoriales listas para consultar y analizar.</span>
                    </article>
                    <article class="metric">
                        <strong>24/7</strong>
                        <span>acceso desde escritorio, tablet o dispositivo móvil.</span>
                    </article>
                    <article class="metric">
                        <strong>1</strong>
                        <span>visión integrada para comprender mejor el territorio.</span>
                    </article>
                </div>
            </div>

            <figure class="hero-visual">
                <img src="~/images/scrz-solo.png"
                     alt="Representación cartográfica de Santa Cruz de la Sierra organizada por capas" />
                <figcaption>Santa Cruz de la Sierra · información organizada por capas</figcaption>
            </figure>
        </div>
    </section>

    <section class="section" id="vision" aria-labelledby="vision-title">
        <div class="section-header">
            <div>
                <div class="eyebrow">Visión territorial</div>
                <h2 id="vision-title">Del país a la ciudad, sin perder el contexto</h2>
            </div>
            <p>
                VisorDatosSIG conecta la escala nacional con el detalle urbano para presentar la información
                geográfica de manera ordenada, comprensible y útil.
            </p>
        </div>

        <div class="grid-2 vision-grid">
            <article class="card card--content">
                <div class="card-body">
                    <span class="section-number">01 · Una lectura más clara</span>
                    <h3>Información territorial que se entiende</h3>
                    <p>
                        La plataforma reúne organización territorial, cartografía urbana y análisis espacial
                        en una experiencia pensada tanto para especialistas como para nuevos usuarios.
                    </p>
                    <div class="mini-features">
                        <div>
                            <strong>Lectura simple</strong>
                            <span>Datos complejos presentados con una jerarquía visual clara.</span>
                        </div>
                        <div>
                            <strong>Escala conectada</strong>
                            <span>Del contexto general al detalle de cada elemento urbano.</span>
                        </div>
                        <div>
                            <strong>Consulta visual</strong>
                            <span>La información se descubre directamente sobre el mapa.</span>
                        </div>
                        <div>
                            <strong>Acceso flexible</strong>
                            <span>Una experiencia consistente en escritorio, tablet y móvil.</span>
                        </div>
                    </div>
                </div>
            </article>

            <article class="card card--territory">
                <div class="card-img">
                    <img src="~/images/bolivia-scrz.png"
                         alt="Mapa de Bolivia conectado con la cartografía urbana de Santa Cruz" />
                </div>
                <div class="card-body">
                    <span class="section-number">02 · Escala territorial</span>
                    <h3>Bolivia y Santa Cruz en una misma narrativa</h3>
                    <p>
                        Una transición visual que ubica la ciudad dentro del país y acerca la lectura hasta su
                        estructura urbana, sus redes y sus unidades catastrales.
                    </p>
                </div>
            </article>
        </div>
    </section>

    <section class="section" id="capas" aria-labelledby="layers-title">
        <div class="section-header">
            <div>
                <div class="eyebrow">Capas vectoriales integradas</div>
                <h2 id="layers-title">Cada capa revela una parte del territorio</h2>
            </div>
            <p>
                Activa la información que necesitas y construye una lectura precisa de la ciudad sin perder
                claridad en el mapa.
            </p>
        </div>

        <div class="layers-panel">
            <div class="layers-panel__intro">
                <span class="section-number">03 · Estructura cartográfica multicapa</span>
                <h3>Cuatro niveles integrados para explorar Santa Cruz</h3>
                <p>
                    El modelo espacial del sistema se fundamenta en cuatro capas vectoriales normalizadas: delimitación física, división predial, conectividad vial y acometidas de servicio. Cada nivel opera de forma autónoma o superpuesta para un diagnóstico territorial preciso.
                </p>
            </div>
            <div class="layers">
                <article class="layer-item layer-item--green">
                    <div class="layer-dot" aria-hidden="true"></div>
                    <span>01 · Polígonos</span>
                    <h4>Manzanas</h4>
                    <p>863 unidades que delimitan la morfología urbana, distritos y unidades vecinales (UV). Esenciales para la zonificación, análisis de densidad y planificación territorial.</p>
                </article>
                <article class="layer-item layer-item--blue">
                    <div class="layer-dot" aria-hidden="true"></div>
                    <span>02 · Parcelas</span>
                    <h4>Lotes</h4>
                    <p>15.280 parcelas catastrales con identificación predial directa (UV, Manzana y Nro. de Lote). Permite la consulta precisa de superficie, linderos y catastro individual.</p>
                </article>
                <article class="layer-item layer-item--orange">
                    <div class="layer-dot" aria-hidden="true"></div>
                    <span>03 · Líneas</span>
                    <h4>Vías</h4>
                    <p>578 ejes viales estructurados por anillos concéntricos, radiales y vías secundarias. Modela la red de movilidad urbana, accesibilidad y conectividad de la ciudad.</p>
                </article>
                <article class="layer-item layer-item--sky">
                    <div class="layer-dot" aria-hidden="true"></div>
                    <span>04 · Puntos</span>
                    <h4>Códigos Fijos</h4>
                    <p>6.261 acometidas georreferenciadas con semáforo de estado operativo (Normal, Para Corte, Cortado, Baja). Soporta identificación al clic y consulta de atributos en campo.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="section" id="arquitectura" aria-labelledby="architecture-title">
        <div class="section-header">
            <div>
                <div class="eyebrow">Arquitectura de solución</div>
                <h2 id="architecture-title">Una base sólida y preparada para crecer</h2>
            </div>
            <p>
                La experiencia visual se sostiene sobre una solución organizada por responsabilidades, fácil de
                mantener y lista para incorporar nuevas capacidades geográficas.
            </p>
        </div>

        <div class="architecture">
            <div class="arch-grid">
                <article class="arch-step">
                    <span class="step-badge">1</span>
                    <h3>Presentación</h3>
                    <p>Interfaz web responsive para consultar el territorio desde cualquier dispositivo.</p>
                </article>
                <article class="arch-step">
                    <span class="step-badge">2</span>
                    <h3>Servicios</h3>
                    <p>Consultas, filtros y servicios que conectan la experiencia con los datos.</p>
                </article>
                <article class="arch-step">
                    <span class="step-badge">3</span>
                    <h3>Dominio geoespacial</h3>
                    <p>Capas, atributos, relaciones espaciales y reglas del territorio.</p>
                </article>
                <article class="arch-step">
                    <span class="step-badge">4</span>
                    <h3>Infraestructura</h3>
                    <p>Persistencia y administración segura de la información geográfica.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="home-mobile" id="movil" aria-labelledby="mobile-title">
        <div class="home-mobile__copy">
            <span class="home-mobile__pill">Experiencia adaptable</span>
            <h2 id="mobile-title">El visor también va contigo.</h2>
            <p>
                Consulta el territorio desde el móvil con la misma información del sistema: mapa, búsqueda,
                identificación y control de capas en una interfaz adaptada a pantallas pequeñas.
            </p>
            <ul class="home-mobile__features">
                <li><span aria-hidden="true">✓</span> Navegación cartográfica táctil</li>
                <li><span aria-hidden="true">✓</span> Capas vectoriales siempre disponibles</li>
                <li><span aria-hidden="true">✓</span> Búsqueda e identificación en campo</li>
            </ul>
            <div class="home-mobile__availability">
                <span aria-hidden="true">
                    <svg viewBox="0 0 24 24"><rect x="6" y="2" width="12" height="20" rx="3" /><path d="M10 18h4" /></svg>
                </span>
                <div><strong>Diseño responsive</strong><small>Web · tablet · móvil</small></div>
            </div>
        </div>

        <div class="home-phone-wrap" aria-label="Vista móvil del sistema VisorDatosSIG">
            <div class="home-phone-glow" aria-hidden="true"></div>
            <div class="home-phone">
                <div class="home-phone__screen">
                    <div class="home-phone__island" aria-hidden="true"></div>
                    <div class="home-phone__status">
                        <span>9:41</span>
                        <span class="home-phone__signals" aria-hidden="true">
                            <i></i><i></i><i></i><b></b>
                            <svg viewBox="0 0 24 24"><path d="M3 9a13 13 0 0 1 18 0M6 12a9 9 0 0 1 12 0M9.5 15.5a4 4 0 0 1 5 0" /><circle cx="12" cy="19" r="1" /></svg>
                        </span>
                    </div>
                    <div class="home-phone__appbar">
                        <span class="home-phone__logo" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M12 21s6-5 6-11a6 6 0 1 0-12 0c0 6 6 11 6 11Z" /><circle cx="12" cy="10" r="2" /></svg>
                        </span>
                        <span><strong>VisorDatosSIG</strong><small>Visor cartográfico</small></span>
                        <button type="button" aria-label="Abrir menú" tabindex="-1"><i></i><i></i><i></i></button>
                    </div>
                    <div class="home-phone__map">
                        <div class="home-phone__search">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
                            <span>Buscar lote, vía o código</span>
                        </div>
                        <div class="home-phone__zoom" aria-hidden="true"><span>+</span><span>−</span></div>
                        <span class="home-phone__marker home-phone__marker--one" aria-hidden="true"></span>
                        <span class="home-phone__marker home-phone__marker--two" aria-hidden="true"></span>
                        <span class="home-phone__marker home-phone__marker--three" aria-hidden="true"></span>
                        <div class="home-phone__location" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="m12 2 7 19-7-4-7 4 7-19Z" /></svg>
                        </div>
                    </div>
                    <div class="home-phone__sheet">
                        <span class="home-phone__handle" aria-hidden="true"></span>
                        <div class="home-phone__sheet-title">
                            <div><strong>Capas del mapa</strong><small>3 de 4 visibles</small></div>
                            <span aria-hidden="true">⌃</span>
                        </div>
                        <div class="home-phone__layers">
                            <span><i class="is-block"></i>Manzanas<b class="is-on"></b></span>
                            <span><i class="is-lot"></i>Lotes<b></b></span>
                            <span><i class="is-road"></i>Vías<b class="is-on"></b></span>
                            <span><i class="is-point"></i>Códigos fijos<b class="is-on"></b></span>
                        </div>
                    </div>
                    <span class="home-phone__homebar" aria-hidden="true"></span>
                </div>
            </div>
        </div>
    </section>

    <section class="cta-banner" id="contacto">
        <div>
            <h3>Explora Santa Cruz con una visión más clara</h3>
            <p>Accede al visor y convierte la información geográfica en una herramienta útil para comprender y decidir.</p>
        </div>
        <div class="cta-actions">
            <div data-sesion-anonimo>
                <a class="btn btn-light" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a>
            </div>
            <div data-sesion-bloque hidden>
                <a class="btn btn-light" asp-controller="Visor" asp-action="Index">Ir al visor cartográfico</a>
            </div>
            <a class="btn btn-ghost" href="#inicio">Volver al inicio</a>
        </div>
    </section>

    <footer>
        <div class="footer-box">
            <div class="footer-legal">
                <strong>© 2026 VisorDatosSIG · Todos los derechos reservados.</strong>
                <p>Plataforma Geoespacial Inteligente para la gestión, migración y visualización del catastro territorial de Santa Cruz de la Sierra. La información cartográfica y alfanumérica se presenta con fines de planificación y consulta técnica territorial.</p>
                <div class="footer-links">
                    <a href="#vision">Visión territorial</a> ·
                    <a href="#capas">Capas vectoriales</a> ·
                    <a href="#arquitectura">Arquitectura</a> ·
                    <span>Términos de servicio</span> ·
                    <span>Política de privacidad</span> ·
                    <span>Gobernanza de datos espaciales</span>
                </div>
            </div>
            <div class="footer-meta">
                <span>Versión 2026 Editorial · Santa Cruz de la Sierra, Bolivia</span>
            </div>
        </div>
    </footer>
</div>
