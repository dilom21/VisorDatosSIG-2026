<dialog id="password-modal" class="password-modal" aria-labelledby="password-titulo" aria-describedby="password-descripcion">
    <div class="password-modal__cabecera">
        <div>
            <span class="password-modal__etiqueta">MI CUENTA</span>
            <h2 id="password-titulo">Cambiar contraseña</h2>
        </div>
        <button type="button" id="password-cerrar" class="password-modal__cerrar" aria-label="Cerrar cambio de contraseña">&times;</button>
    </div>
    <p id="password-descripcion">Actualice su contraseña para proteger el acceso a su cuenta.</p>
    <form id="password-form" class="password-form">
        <fieldset id="password-campos">
            <legend class="visually-hidden">Datos para cambiar la contraseña</legend>
            <label for="actual">Contraseña actual</label>
            <input id="actual" name="passwordActual" type="password" autocomplete="current-password" maxlength="200" required />
            <label for="nueva">Nueva contraseña</label>
            <input id="nueva" name="passwordNueva" type="password" autocomplete="new-password" minlength="8" maxlength="200" aria-describedby="password-ayuda" required />
            <p id="password-ayuda" class="password-form__ayuda">Entre 8 y 200 caracteres, diferente de la contraseña actual.</p>
            <label for="confirmacion">Confirmar nueva contraseña</label>
            <input id="confirmacion" name="confirmarPassword" type="password" autocomplete="new-password" minlength="8" maxlength="200" required />
        </fieldset>
        <p id="password-mensaje" class="password-form__mensaje" role="status" aria-live="polite" hidden></p>
        <button type="button" id="password-reintentar" class="btn-secundario" hidden>Reintentar verificación</button>
        <div class="password-modal__acciones">
            <button type="button" id="password-cancelar" class="btn-secundario">Cancelar</button>
            <button type="submit" id="password-guardar" class="btn-primario">Guardar contraseña</button>
        </div>
    </form>
</dialog>
