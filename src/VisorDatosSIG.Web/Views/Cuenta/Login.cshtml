@{
    ViewData["Title"] = "Iniciar sesión";
    ViewData["HideHeader"] = true;
    ViewData["FullWidth"] = true;
    ViewData["BodyClass"] = "login-page-fullscreen";
}

<section class="login-split">
    @* Columna izquierda (52% a 55% de pantalla): imagen scrz-capas a pantalla completa con navegación y título *@
    <div class="login-split__visual">
        <a asp-controller="Home" asp-action="Index" class="login-split__back" aria-label="Volver a la página de inicio">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            <span>Volver al inicio</span>
        </a>

        <div class="login-split__image-container">
            <img src="~/images/scrz-capas.png" alt="Cartografía y capas vectoriales de Santa Cruz de la Sierra" class="login-split__image" />
        </div>

        <div class="login-split__overlay">
            <span class="login-split__badge">Modelo Cartográfico Territorial</span>
            <h1 class="login-split__hero-title">Santa Cruz Geoespacial</h1>
            <p class="login-split__hero-desc">Explora la infraestructura de datos territoriales, manzanas, lotes, red vial y suministros en un único visor inteligente.</p>
        </div>
    </div>

    @* Columna derecha: formulario limpio, moderno y centrado *@
    <div class="login-split__form-container">
        <div class="login-split__form-box">
            <div class="login-split__header">
                <div class="login-split__brand-inline">
                    <img src="~/images/logo.png" alt="Logo VisorDatosSIG" width="38" height="38" class="login-split__logo" />
                    <span class="login-split__brand-name">VisorDatosSIG</span>
                </div>
                <h2 class="login-split__headline">Iniciar Sesión</h2>
                <p class="login-split__subheadline">Ingresa tus credenciales para acceder a la plataforma geoespacial.</p>
            </div>

            @* El formulario usa method="post" para que la contraseña nunca viaje por la URL.
               El envío real y validaciones lo maneja login.js usando los IDs definidos. *@
            <form id="form-login" method="post" novalidate
                  data-return-url="@ViewData["ReturnUrl"]" data-motivo="@ViewData["Motivo"]">

                <div class="login-split__field">
                    <label for="usuario" class="login-split__label">Usuario o correo</label>
                    <div class="login-split__input-wrap">
                        <span class="login-split__input-icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                        </span>
                        <input id="usuario" name="login" type="text" autocomplete="username"
                               placeholder="Ingresa tu usuario" maxlength="100" required autofocus class="login-split__input" />
                    </div>
                </div>

                <div class="login-split__field">
                    <label for="password" class="login-split__label">Contraseña</label>
                    <div class="login-split__input-wrap">
                        <span class="login-split__input-icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                            </svg>
                        </span>
                        <input id="password" name="password" type="password"
                               placeholder="Ingresa tu contraseña"
                               autocomplete="current-password" maxlength="200" required class="login-split__input" />
                        <button type="button" id="btn-mostrar-password" class="login-split__toggle-btn"
                                aria-pressed="false" aria-controls="password">Mostrar</button>
                    </div>
                </div>

                <button type="submit" id="btn-iniciar-sesion" class="btn-primario login-split__submit-btn">
                    <span>Iniciar sesión</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14M12 5l7 7-7 7" />
                    </svg>
                </button>

                <p id="login-mensaje" class="login-mensaje" role="alert" hidden></p>
                <p id="login-info" class="login-info" role="status" hidden></p>
            </form>

            <div class="login-split__footer">
                <p class="login-split__help-text">
                    ¿No cuentas con credenciales de acceso?
                    <a asp-controller="Home" asp-action="Index">Volver a la portada</a>
                </p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/auth/login.js"></script>
}
