@{
    ViewData["Title"] = "Iniciar sesión";
}

<section class="login-shell">
    <div class="login-card">

        @* Panel de identidad. Decorativo salvo el título, que es el h1 de la página. *@
        <div class="login-panel">
            <svg class="login-panel__trama" viewBox="0 0 420 420" fill="none" stroke="#ffffff"
                 stroke-width="1.1" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid slice">
                <path d="M-30 330 C 50 268, 118 352, 198 292 S 336 232, 450 296" />
                <path d="M-30 362 C 50 300, 118 384, 198 324 S 336 264, 450 328" />
                <path d="M-30 394 C 50 332, 118 416, 198 356 S 336 296, 450 360" />
                <path d="M-30 100 C 60 52, 140 128, 224 78 S 356 40, 450 96" />
                <circle cx="306" cy="96" r="42" />
                <circle cx="306" cy="96" r="72" />
                <circle cx="306" cy="96" r="104" />
                <path d="M306 96 380 190" />
                <circle cx="96" cy="228" r="5" />
                <circle cx="150" cy="180" r="5" />
                <circle cx="60" cy="286" r="5" />
            </svg>

            <span class="login-panel__mark" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                    <path d="M12 21.2s6.6-5.4 6.6-10.4a6.6 6.6 0 1 0-13.2 0c0 5 6.6 10.4 6.6 10.4Z" />
                    <circle cx="12" cy="10.4" r="2.5" />
                </svg>
            </span>

            <h1 class="login-panel__brand">VisorDatosSIG</h1>
            <p class="login-panel__tagline">Migración y consulta de información geográfica</p>
        </div>

        @* Panel del formulario. *@
        <div class="login-form-panel">
            <div class="login-form-panel__intro">
                <h2>Bienvenido</h2>
                <p>Inicie sesión para continuar</p>
            </div>

            @* El formulario usa method="post" para que, si JavaScript falla, la
               contraseña nunca viaje por la URL. El envío real lo maneja login.js. *@
            <form id="form-login" method="post" novalidate
                  data-return-url="@ViewData["ReturnUrl"]" data-motivo="@ViewData["Motivo"]">

                <div class="login-campo">
                    <label for="usuario">Usuario</label>
                    <input id="usuario" name="login" type="text" autocomplete="username"
                           maxlength="100" required autofocus />
                </div>

                <div class="login-campo">
                    <label for="password">Contraseña</label>
                    <div class="login-grupo-password">
                        <input id="password" name="password" type="password"
                               autocomplete="current-password" maxlength="200" required />
                        <button type="button" id="btn-mostrar-password"
                                aria-pressed="false" aria-controls="password">Mostrar</button>
                    </div>
                </div>

                <button type="submit" id="btn-iniciar-sesion" class="btn-primario">Iniciar sesión</button>

                <p id="login-mensaje" class="login-mensaje" role="alert" hidden></p>
                <p id="login-info" class="login-info" role="status" hidden></p>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/auth/login.js"></script>
}
